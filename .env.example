# Copy to .env and fill in.

# The myshopify subdomain only, e.g. "gifty-dev" for gifty-dev.myshopify.com
SHOPIFY_STORE=giftyautomation

# Storefront base URL. Defaults to https://$SHOPIFY_STORE.myshopify.com
# STORE_URL=https://your-store.myshopify.com

# Admin base URL. Defaults to https://admin.shopify.com/store/$SHOPIFY_STORE
# ADMIN_URL=https://admin.shopify.com/store/your-store

# Product paths added to the cart before selectors are discovered (comma separated).
PRODUCT_PATHS=/products/the-complete-snowboard,/products/the-multi-location-snowboard

# Product added as the gift line (and then deleted) for each primary product.
GIFT_PRODUCT_HANDLE=the-collection-snowboard-oxygen

# Optional Admin API token (shpat_...) with read_themes + write_themes. Enables API theme deletion.
# SHOPIFY_ADMIN_TOKEN=
# Or, for Dev Dashboard apps: client credentials (exchanged for a 24h token automatically).
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# Theme Access password (shptka_...) for deleting themes via the Shopify CLI (needs Node 22+).
SHOPIFY_THEME_ACCESS_PASSWORD=shptka_2a69a7e741cb0bec0301e661f98e5553
# SHOPIFY_CLI_BIN=shopify

# Where the saved login session lives (created by `npm run login`).
AUTH_STATE=./auth.json

# Input list of theme store URLs (produced by shopify_theme_scraper.py).
THEMES_FILE=./shopify_themes.json

# Output file that selector records are appended to.
OUTPUT_FILE=./theme-selectors.json

# Screenshot output directory.
SNAPSHOT_DIR=./snapshots

# Run with a visible browser (1) or headless (0).
HEADED=1

# Milliseconds to wait for a theme install to finish.
INSTALL_TIMEOUT=180000

# Persistent Chrome profile that keeps the Shopify login between runs.
# USER_DATA_DIR=./.browser-profile

# Browser to drive: "chrome" (installed Chrome, default) or empty for bundled Chromium.
# BROWSER_CHANNEL=chrome
